# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
# Full reference: architecture/TECHNICAL_DESIGN.md — Appendix, environment variables.

# --- Supabase -----------------------------------------------------------------
# Public and RLS-bound. Safe in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# BYPASSES ROW LEVEL SECURITY. Server-only, and importable exclusively from
# src/lib/supabase/admin.ts, which an ESLint rule confines to
# app/api/webhooks/* and app/api/cron/* — endpoints called by machines, not users.
# A leak here removes the second enforcement layer described in ARCHITECTURE.md §3.3.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google SSO -----------------------------------------------------------------
# Read by the Supabase CLI itself (supabase/config.toml's [auth.external.google], via its
# env() substitution) to configure Google sign-in on the local Auth stack — not consumed by
# Next.js directly. From a Google Cloud OAuth client with authorized redirect URI
# http://127.0.0.1:54321/auth/v1/callback for local dev. Run `npx supabase stop && npx
# supabase start` after setting these for the config change to take effect.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Email (Resend) -----------------------------------------------------------
# Used by POST /api/webhooks/notifications to send the transactional half of a
# notification. The in-system half is written by a database trigger and does not
# depend on these.
RESEND_API_KEY=
EMAIL_FROM=

# --- Machine endpoint secrets -------------------------------------------------
# Shared secret on the Supabase database webhook; compared in constant time.
NOTIFICATIONS_WEBHOOK_SECRET=
# Bearer token Vercel Cron presents to GET /api/cron/waitlist-expiry.
CRON_SECRET=

# --- Site ---------------------------------------------------------------------
# Absolute origin used for auth redirects and links inside emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
